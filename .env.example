# Backend settings (read by the Go process)
PORT=8080
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=campusecho

# Local development prints OTP codes in the API terminal.
EMAIL_MODE=console

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourgmail@gmail.com
SMTP_PASSWORD=enter your app password
SMTP_FROM=yourgmail@gmail.com

# false for local HTTP; set true when running behind HTTPS.
COOKIE_SECURE=false

# Triage configuration for local development. The development mock is explicit
# and deterministic; it is not a real AI model and is rejected outside development.
APP_ENV=development
TRIAGE_PROVIDER=development-mock
BRIGADING_MODE=development-noop
# For real FR-8 detection, set BRIGADING_MODE=gemini and configure
# GEMINI_API_KEY. Semantic embeddings are cached on feedback documents.
TRIAGE_WORKERS=2
TRIAGE_QUEUE_SIZE=64
TRIAGE_MAX_RETRIES=3
TRIAGE_RETRY_BACKOFF=2s
TRIAGE_PROCESSING_TIMEOUT=25s
TRIAGE_RECOVERY_INTERVAL=15s
TRIAGE_LEASE_DURATION=1m
TRIAGE_DUPLICATE_THRESHOLD=0.82

# To test real classification with Gemini Free Tier, use
# TRIAGE_PROVIDER=gemini and set GEMINI_API_KEY in your local .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# To use Anthropic instead, set TRIAGE_PROVIDER=anthropic and provide a key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages